# AAPSON Platform Secrets - SOPS Encrypted (Template)
# 
# DECRYPT: sops -d .env.local.enc > .env.local
# ENCRYPT: sops -e .env.local > .env.local.enc
#
# NEVER commit .env.local or any decrypted secrets!
# Only commit .env.local.enc (encrypted version)
#
# Generate age key: age-keygen -o age-key.txt
# Add public key to .sops.yaml

# ============================================
# MERCADO PAGO (Platform - our MP account)
# ============================================
MP_ACCESS_TOKEN=APP_USR-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
MP_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ============================================
# ENCRYPTION KEYS (Global KEKs)
# ============================================
# Data Encryption Key (KEK) - base64 encoded 32 bytes
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_KEK=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DATA_KEK_VERSION=v1

# Argon2id password pepper - base64 encoded 32 bytes
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PASSWORD_PEPPER=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Blind index key for searchable encryption - base64 encoded 32 bytes
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BLIND_INDEX_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ============================================
# SUPABASE (Platform)
# ============================================
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.