# AAPSON Platform Secrets - Template (DO NOT USE REAL VALUES)
# 
# Copy this to .env.local and fill in real values
# Then encrypt with: sops -e .env.local > .env.local.enc
# Decrypt with: sops -d .env.local.enc > .env.local
#
# NEVER commit .env.local or any decrypted secrets!
# Only commit .env.local.enc (encrypted version)
#
# Generate age key: age-keygen -o age-key.txt
# Add public key to .sops.yaml

# ============================================
# MERCADO PAGO (Platform - our MP account)
# ============================================
MP_ACCESS_TOKEN=APP_USR-YOUR_MERCADOPAGO_ACCESS_TOKEN_HERE
MP_WEBHOOK_SECRET=whsec_YOUR_MERCADOPAGO_WEBHOOK_SECRET_HERE

# ============================================
# ENCRYPTION KEYS (Global KEKs)
# ============================================
# Data Encryption Key (KEK) - base64 encoded 32 bytes
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_KEK=YOUR_BASE64_ENCODED_32_BYTE_KEY_HERE
DATA_KEK_VERSION=v1

# Argon2id password pepper - base64 encoded 32 bytes
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PASSWORD_PEPPER=YOUR_BASE64_ENCODED_32_BYTE_KEY_HERE

# Blind index key for searchable encryption - base64 encoded 32 bytes
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BLIND_INDEX_KEY=YOUR_BASE64_ENCODED_32_BYTE_KEY_HERE

# ============================================
# SUPABASE (Platform)
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_SERVICE_ROLE_KEY_HERE

# ============================================
# VERCEL (Platform)
# ============================================
VERCEL_TOKEN=YOUR_VERCEL_TOKEN_HERE
VERCEL_ORG_ID=YOUR_ORG_ID
VERCEL_PROJECT_ID=YOUR_PROJECT_ID

# ============================================
# APP CONFIG
# ============================================
AVANCA_API_URL=https://avanca.com.br
VITRINE_CERTA_WEBHOOK_URL=https://vitrine-certa.aapson.dev/api/avanca-webhook
ATLAS_API_URL=http://localhost:3000/api/atlas/dunning-trigger
ATLAS_WEBHOOK_SECRET=YOUR_ATLAS_WEBHOOK_SECRET_HERE

# ============================================
# NODE ENV
# ============================================
NODE_ENV=development